.build/
.swiftpm/
*.xcodeproj
Package.resolved
.DS_Store

# kagami SQLite history scratch (shard-merged, never committed)
# [[kagami-test-history-shard-drain-not-global-write]]
.kagami/history.db*
.kagami/tmp/
# auto-discovery cache; scopes.override.toml is the committed SSoT
.kagami/scopes.toml
# Secrets — env files and every backup of them never belong in git.
# A backup is git history, not a copy next to the file.
.env
.env.*
*.env
*.env.bak*
*.env.back*
!.env.example
!.env.template
!.env.sample
!.env.dist
!*.env.example
!*.env.template
